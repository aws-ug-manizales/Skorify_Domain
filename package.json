{
  "name": "@skorify/domain",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "pnpm build",
    "build": "npx tsc -p tsconfig.json",
    "build:dev": "npx tsc -p tsconfig.json && pnpm run copy-package && pnpm run copy-to-server && pnpm run copy-to-shared",
    "build-pipeline": "npx tsc -p tsconfig.json && pnpm run copy-package && pnpm run copy-to-server-pipeline && pnpm run copy-to-shared-pipeline",
    "test": "jest",
    "test:watch": "jest --watch",
    "copy-package": "copyfiles  package.json dist/",
    "copy-to-server": "copyfiles -u 1 dist/**/* ../server/libs/domain",
    "copy-to-shared": "copyfiles -u 1 dist/**/* ../shared/libs/domain",
    "copy-to-server-pipeline": "copyfiles -u 1 dist/**/* ../../../server/libs/domain",
    "copy-to-shared-pipeline": "copyfiles -u 1 dist/**/* ../shared/libs/domain && copyfiles -u 1 dist/**/* ../../shared/libs/domain && copyfiles -u 1 dist/**/* ../../../shared/libs/domain"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/jest": "^29.5.14",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.7.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./match": {
      "types": "./dist/features/match/index.d.ts",
      "default": "./dist/features/match/index.js"
    },
    "./user": {
      "types": "./dist/features/user/index.d.ts",
      "default": "./dist/features/user/index.js"
    },
    "./team": {
      "types": "./dist/features/team/index.d.ts",
      "default": "./dist/features/team/index.js"
    },
    "./prediction": {
      "types": "./dist/features/prediction/index.d.ts",
      "default": "./dist/features/prediction/index.js"
    },
    "./tournament": {
      "types": "./dist/features/tournament/index.d.ts",
      "default": "./dist/features/tournament/index.js"
    },
    "./tournament-instance": {
      "types": "./dist/features/tournament-instance/index.d.ts",
      "default": "./dist/features/tournament-instance/index.js"
    },
    "./user-enrollment": {
      "types": "./dist/features/user-enrollment/index.d.ts",
      "default": "./dist/features/user-enrollment/index.js"
    }
  }
}
